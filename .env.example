# LLM API配置
LLM_PROVIDER=anthropic          # anthropic 或 openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=                   # 自定义API地址，留空使用官方默认
ANALYSIS_MODEL=claude-sonnet-4-6

# 兼容旧配置（如设置了LLM_API_KEY可忽略）
# ANTHROPIC_API_KEY=your_api_key_here

# 数据库配置
DATABASE_PATH=data/articles.db

# 采集配置
SEARCH_KEYWORDS=大模型,Claude,GPT,AI,人工智能,LLM
MAX_ARTICLES_PER_SEARCH=20

# 微信公众号配置
WECHAT_APP_ID=your_appid
WECHAT_APP_SECRET=your_appsecret

# 文章生成配置
ARTICLE_MODEL=claude-sonnet-4-6  # 文章生成使用的模型
ARTICLE_STYLE=news               # news(资讯)/comment(评论)/deep(深度)
ARTICLE_MAX_TOKENS=4000          # 生成文章最大token数

# 热点新闻源配置
HOTNEWS_SOURCES=toutiao,baidu,weibo
HOTNEWS_REFRESH_INTERVAL=30     # 热点刷新间隔（分钟）

# 自动调度配置
SCHEDULER_HOTNEWS_CRON=*/30 * * * *     # 热点采集cron
SCHEDULER_GENERATE_CRON=0 8,12,18 * * * # 文章生成cron
SCHEDULER_PUBLISH_CRON=0 9,13,19 * * *  # 文章发布cron
SCHEDULER_AUTO_PUBLISH=false             # 是否自动发布
